# Application
IT_APP_NAME=DocMind IT Assistant
IT_ENVIRONMENT=development
IT_HOST=127.0.0.1
IT_PORT=8020
IT_ADMIN_HOST=127.0.0.1
IT_ADMIN_PORT=8021

# Database. SQLite is the zero-dependency local default. Production requires PostgreSQL
# with the pgvector extension available on the server: migration 0003 runs
# `CREATE EXTENSION IF NOT EXISTS vector` and fails without it (use the image
# `pgvector/pgvector:pg17`, or have a DBA create the extension first). See README.
IT_DATABASE_URL=sqlite:///data/queries.db
IT_DB_POOL_SIZE=5
IT_DB_MAX_OVERFLOW=10
IT_DB_POOL_TIMEOUT=30
IT_DB_CONNECT_TIMEOUT=5

# Authentication: development | local | trusted_headers | oidc
# Production requires oidc. Use a random secret of at least 32 characters.
IT_AUTH_MODE=development
IT_LOCAL_USERNAME=admin
IT_LOCAL_PASSWORD_HASH=
IT_LOCAL_DISPLAY_NAME=本地管理员
IT_LOCAL_SESSION_HOURS=12
# Roles granted by the local login. Governance roles are opt-in per deployment.
IT_LOCAL_ROLES=admin,auditor,viewer
IT_GUEST_LOGIN_ENABLED=false
IT_GUEST_SESSION_HOURS=2
IT_OIDC_ISSUER=
IT_OIDC_AUDIENCE=
IT_OIDC_JWKS_URL=
IT_OIDC_ROLE_CLAIM=roles
IT_OIDC_GROUP_CLAIM=groups
IT_OIDC_LEEWAY_SECONDS=30
# OIDC Authorization Code + PKCE (browser login). client_id/redirect_uri are required in oidc mode.
# Endpoints default to discovery at <issuer>/.well-known/openid-configuration; override only if
# the IdP cannot serve discovery (e.g. intranet with no metadata endpoint).
IT_OIDC_CLIENT_ID=
IT_OIDC_CLIENT_SECRET=
IT_OIDC_REDIRECT_URI=http://127.0.0.1:8020/api/auth/oidc/callback
IT_OIDC_SCOPES=openid profile email
IT_OIDC_SESSION_HOURS=12
IT_OIDC_AUTHORIZATION_ENDPOINT=
IT_OIDC_TOKEN_ENDPOINT=
IT_OIDC_END_SESSION_URL=
IT_AUTH_SUBJECT_SALT=development-only
# Field-level encryption key for query.question (Fernet). Leave empty only for local/dev
# (a fixed development key is used and a warning is logged). Production REQUIRES a value.
# Supply a raw 32-byte Fernet key OR any passphrase; a passphrase is derived into a key via SHA-256.
IT_QUERY_FIELD_KEY=

# Project-local paths. Relative paths resolve from this repository root.
IT_KNOWLEDGE_PATH=knowledge.md
IT_WEB_INDEX_PATH=web/index.html
IT_ADMIN_INDEX_PATH=web/admin.html
IT_ARTIFACT_OUTPUT_PATH=data/artifacts

# Model routing: knowledge | local | cloud
IT_MODEL_MODE=knowledge
IT_BUILTIN_MODEL=deterministic
IT_LOCAL_PROVIDER=ollama
IT_LOCAL_MODEL=qwen2.5:7b
IT_CLOUD_PROVIDER=qwen
IT_CLOUD_MODEL=qwen-plus
IT_CLOUD_BASE_URL=
IT_LOCAL_BASE_URL=
IT_CUSTOM_BASE_URL=
IT_MODEL_TIMEOUT_SECONDS=30
IT_MODEL_MAX_RETRIES=1
IT_MODEL_RETRY_BACKOFF_SECONDS=0.25
IT_MODEL_MAX_OUTPUT_TOKENS=512
IT_MODEL_TEMPERATURE=0.1

# Document embeddings and hybrid retrieval. Production must use provider.
IT_EMBEDDING_MODE=hash
IT_EMBEDDING_PROVIDER=qwen
IT_EMBEDDING_MODEL=text-embedding-v3
IT_EMBEDDING_BASE_URL=
IT_EMBEDDING_DIMENSION=1024
IT_EMBEDDING_TIMEOUT_SECONDS=60
IT_EMBEDDING_BATCH_SIZE=16
IT_DOCUMENT_MAX_BYTES=20971520
IT_DOCUMENT_MAX_CHARACTERS=2000000
IT_DOCUMENT_MAX_PAGES=500
IT_CHUNK_MAX_CHARS=1200
IT_CHUNK_OVERLAP_CHARS=150
IT_RETRIEVAL_TOP_K=5

# Knowledge governance: direct | review
# direct = indexing completes and the version is published immediately (legacy behaviour).
# review = indexing stops at "staged"; a reviewer must approve and a publisher must publish.
# This example file enables the single-admin override so a local demo can complete the flow.
# Production should keep the override off and grant the governance roles through OIDC.
IT_GOVERNANCE_MODE=direct
IT_GOVERNANCE_REQUIRE_SEPARATION_OF_DUTIES=true
IT_GOVERNANCE_ALLOW_ADMIN_OVERRIDE=true

# Asynchronous indexing worker. When enabled, the import endpoint queues the document and
# returns 202 immediately; run the worker with `python -m worker` (or `--once` from cron).
# `scripts/dev.ps1` and the compose file override this to true because they also start a worker;
# enabling it without one leaves jobs queued forever.
# Heartbeat must stay smaller than the job timeout, otherwise live jobs get reclaimed.
IT_INGESTION_WORKER_ENABLED=false
IT_INGESTION_WORKER_ID=
IT_INGESTION_POLL_SECONDS=2
IT_INGESTION_MAX_ATTEMPTS=3
IT_INGESTION_JOB_TIMEOUT_SECONDS=600
IT_INGESTION_HEARTBEAT_SECONDS=30
# Retry backoff ceiling for requeued ingestion jobs (seconds). The first retry waits ~base, then
# doubles up to this cap; 0 disables the delay (useful for tests/immediate resume).
IT_INGESTION_BACKOFF_MAX_SECONDS=1800
# Slow-request / slow-query thresholds (ms): requests or DB statements slower than these are logged
# at WARNING so operators can spot stragglers without external APM.
IT_SLOW_REQUEST_MS=1000
IT_SLOW_DB_MS=200
# Per-user daily query quota (0 disables). Exceeding returns HTTP 429 + Retry-After.
IT_QUERY_DAILY_QUOTA=1000
# Indexing engine: simple | langgraph
# `langgraph` requires requirements-worker.txt and adds checkpointed resume: a worker killed
# mid-run continues instead of paying for embedding batches twice. Checkpoints go to a separate
# file/schema on purpose, so `alembic check` never sees framework tables.
IT_INGESTION_ENGINE=simple
IT_INGESTION_CHECKPOINT_PATH=data/worker-checkpoints.db

# Evaluation gate (golden questions). `block` refuses to publish a version whose metrics fall
# below the thresholds; `warn` only records the result; `off` skips the pre-publish run entirely.
# Overriding a blocking gate requires IT_EVAL_ALLOW_OVERRIDE=true AND a principal holding both
# document.publish and governance.override; the bypass is recorded as an override_gate review.
IT_EVAL_GATE_MODE=warn
IT_EVAL_ALLOW_OVERRIDE=false
IT_EVAL_MIN_RECALL=0.8
IT_EVAL_MIN_CITATION_ACCURACY=0.9
IT_EVAL_MAX_REGRESSION=0.05
IT_EVAL_TOP_K=5

# Provider credentials may be set here or in the process environment.
# Process environment wins. Never commit real values or the local .env file.
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
SILICONFLOW_API_KEY=
OPENAI_API_KEY=
IT_CUSTOM_API_KEY=

# Logging
IT_LOG_LEVEL=INFO
IT_LOG_JSON=true
