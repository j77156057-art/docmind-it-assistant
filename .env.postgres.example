# Application
IT_APP_NAME=DocMind IT Assistant
IT_ENVIRONMENT=development
IT_HOST=127.0.0.1
IT_PORT=8020
IT_ADMIN_HOST=127.0.0.1
IT_ADMIN_PORT=8021

# PostgreSQL. Escape special URL characters in passwords.
IT_DATABASE_URL=postgresql+psycopg://docmind:change-me@127.0.0.1:5432/docmind_it
IT_DB_POOL_SIZE=5
IT_DB_MAX_OVERFLOW=10
IT_DB_POOL_TIMEOUT=30
IT_DB_CONNECT_TIMEOUT=5

# Authentication: development | trusted_headers | oidc
# Production requires oidc. Use a random secret of at least 32 characters.
IT_AUTH_MODE=development
IT_OIDC_ISSUER=
IT_OIDC_AUDIENCE=
IT_OIDC_JWKS_URL=
IT_OIDC_ROLE_CLAIM=roles
IT_OIDC_GROUP_CLAIM=groups
IT_OIDC_LEEWAY_SECONDS=30
IT_OIDC_CLIENT_ID=
IT_OIDC_CLIENT_SECRET=
IT_OIDC_REDIRECT_URI=http://127.0.0.1:8020/api/auth/oidc/callback
IT_OIDC_SCOPES=openid profile email
IT_OIDC_SESSION_HOURS=12
IT_OIDC_AUTHORIZATION_ENDPOINT=
IT_OIDC_TOKEN_ENDPOINT=
IT_OIDC_END_SESSION_URL=
IT_AUTH_SUBJECT_SALT=development-only
# Field-level encryption key for query.question (Fernet). Production REQUIRES a value; a raw
# 32-byte Fernet key or any passphrase (derived via SHA-256) is accepted.
IT_QUERY_FIELD_KEY=

# Project-local paths. Relative paths resolve from this repository root.
IT_KNOWLEDGE_PATH=knowledge.md
IT_WEB_INDEX_PATH=web/index.html
IT_ADMIN_INDEX_PATH=web/admin.html
IT_ARTIFACT_OUTPUT_PATH=data/artifacts

# Model routing: knowledge | local | cloud
IT_MODEL_MODE=knowledge
IT_BUILTIN_MODEL=deterministic
IT_LOCAL_PROVIDER=ollama
IT_LOCAL_MODEL=qwen2.5:7b
IT_CLOUD_PROVIDER=qwen
IT_CLOUD_MODEL=qwen-plus
IT_CLOUD_BASE_URL=
IT_LOCAL_BASE_URL=
IT_CUSTOM_BASE_URL=
IT_MODEL_TIMEOUT_SECONDS=30
IT_MODEL_MAX_RETRIES=1
IT_MODEL_RETRY_BACKOFF_SECONDS=0.25
IT_MODEL_MAX_OUTPUT_TOKENS=512
IT_MODEL_TEMPERATURE=0.1

# Document embeddings and hybrid retrieval. Production must use provider.
IT_EMBEDDING_MODE=hash
IT_EMBEDDING_PROVIDER=qwen
IT_EMBEDDING_MODEL=text-embedding-v3
IT_EMBEDDING_BASE_URL=
IT_EMBEDDING_DIMENSION=1024
IT_EMBEDDING_TIMEOUT_SECONDS=60
IT_EMBEDDING_BATCH_SIZE=16
IT_DOCUMENT_MAX_BYTES=20971520
IT_DOCUMENT_MAX_CHARACTERS=2000000
IT_DOCUMENT_MAX_PAGES=500
IT_CHUNK_MAX_CHARS=1200
IT_CHUNK_OVERLAP_CHARS=150
IT_RETRIEVAL_TOP_K=5

# Async indexing worker (run `python -m worker` separately)
IT_INGESTION_WORKER_ENABLED=false
IT_INGESTION_WORKER_ID=
IT_INGESTION_POLL_SECONDS=2
IT_INGESTION_MAX_ATTEMPTS=3
IT_INGESTION_JOB_TIMEOUT_SECONDS=600
IT_INGESTION_HEARTBEAT_SECONDS=30
IT_INGESTION_BACKOFF_MAX_SECONDS=1800
IT_INGESTION_ENGINE=simple

# Observability: slow-request / slow-query thresholds (ms)
IT_SLOW_REQUEST_MS=1000
IT_SLOW_DB_MS=200
# Per-user daily query quota (0 disables). Exceeding returns HTTP 429 + Retry-After.
IT_QUERY_DAILY_QUOTA=1000
# Document retention (days): once a document exceeds this age it is soft-marked (expired_at),
# then hard-deleted after the grace window (soft-then-hard). Run `python scripts/purge_expired.py`
# from cron to apply; the soft stage is idempotent and the hard stage only removes marked, aged rows.
IT_RETENTION_DAYS=365
IT_RETENTION_GRACE_DAYS=30

# Provider credentials may be set here or in the process environment.
# Process environment wins. Never commit real values or the local .env file.
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
SILICONFLOW_API_KEY=
OPENAI_API_KEY=
IT_CUSTOM_API_KEY=

# Logging
IT_LOG_LEVEL=INFO
IT_LOG_JSON=true
